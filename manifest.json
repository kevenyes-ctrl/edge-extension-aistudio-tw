{
  "manifest_version": 3,
  "name": "Google AI Studio 繁體中文助手",
  "version": "1.2.0",
  "description": "將 Google AI Studio 介面轉為繁體中文（台灣慣用詞），保持提示詞與對話內容不變。",
  "content_scripts": [
    {
      "matches": ["https://aistudio.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
